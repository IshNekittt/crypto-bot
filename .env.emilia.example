# ============================================================
# .env.emilia — V5 SNIPER PROFILE (Scenario 12, 1m execution)
# ============================================================
# FROZEN PROFILE. Strategy values below are the verified "1C" baseline plus
# the per-symbol grid-search calibration. Do not retune without a new baseline.
#
# This file is a PROFILE, not a standalone deployment: it deliberately contains
# NO API keys, Telegram tokens or database URLs. Inject the secrets listed in
# "REQUIRED SECRETS" through the platform (Docker env_file chain, Render
# dashboard, systemd EnvironmentFile) before the process can boot.
#
# Complement: .env.subaru (V4 Classic Tank — S1 + S5, 15m execution).
# The two profiles MUST NEVER share a process, database, Telegram bot or Bybit
# sub-account: the per-symbol IN_TRADE slot is mutually exclusive (AGENTS.md §1.2,
# §1.3, Invariant §16.3.8).
# ============================================================

# --- V5 SNIPER PROFILE (EMILIA) ---
SYMBOLS=NEARUSDT,APTUSDT
ENABLE_SNIPER_MODE=true
ACTIVE_SCENARIOS=12

# Dynamic TP
ENABLE_DYNAMIC_TP=true
DYNAMIC_TP_MIN_RR=1.5
DYNAMIC_TP_MAX_RR=6.0

# S12 Sweep Sources
S12_SESSION_SWEEPS=true
S12_EQH_EQL_SWEEPS=true

# Global P0 Shields & Execution
MIN_NET_RR=1.5
MIN_VOLATILITY_FEE_RATIO=1.5
SMC_SWEEP_MIN_WICK_RATIO=0.25
SMC_SL_ATR_OFFSET=0.5
MIN_TP_DISTANCE_PCT=0.0035
SNIPER_LIMIT_EXPIRATION_CANDLES=15

# --- Per-Symbol Overrides ---
# NEARUSDT: 180d endurance audit (data/endurance_report.md). Global 1.5/1.5
# returned +3.46%; volatility alone at 1.0 returned +14.87%; volatility + net-R
# at 1.0 returns +22.40% (PF 3.24, DD 4.74%). Both are S12-only admission gates,
# each rejecting <0.5% of candidates — relaxing them for this pair is measured
# calibration. The global 1.5 shields stay armed for APTUSDT and any other pair.
MIN_VOLATILITY_FEE_RATIO_NEARUSDT=1.0
MIN_NET_RR_NEARUSDT=1.0

# APTUSDT: verified Sniper calibration
SMC_SL_ATR_OFFSET_APTUSDT=0.60
SNIPER_LIMIT_EXPIRATION_CANDLES_APTUSDT=25

# ============================================================
# REQUIRED SECRETS — enumerates only, no values (inject at deploy)
# ============================================================
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# DATABASE_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BACKUP_PASSWORD=
#
# loadConfig() hard-fails without SYMBOLS (above), RISK_PERCENT (below) and the
# five secret keys. See .env.example for the full reference.

# ============================================================
# OPERATIONAL SCAFFOLDING — non-secret, carried over from the previous
# Emilia deployment. Not part of the frozen strategy spec.
# ============================================================
# RISK_PERCENT is REQUIRED (no default); loadConfig() throws when absent.
RISK_PERCENT=2
REDUCED_RISK_PERCENT=1
LEVERAGE=10

# Capacity cap for position sizing and the Drawdown Guard (USDT).
# Must be a positive number — a literal 0 fails validation (AGENTS.md Inv. 55).
MAX_WORKING_CAPITAL=3000

# DEMO_TRADING=true forces TESTNET=false (Bybit Demo, virtual balance).
DEMO_TRADING=true
TESTNET=false
AUTO_TRADING=true
TRADE_APPROVAL_TIMEOUT_MINUTES=5
ENABLE_LIVE_TEST_ORDERS=false

# Sniper Mode still reads the 15m radar + 4H macro feeds.
LTF_TIMEFRAME=15
HTF_TIMEFRAME=240
HISTORY_CANDLES=300
MACRO_CANDLES=1000
COOLDOWN_CANDLES=16
SNIPER_DISPLACEMENT_MULTIPLIER=1.5
SMART_ENTRY_THRESHOLD_PCT=0.15
LIMIT_EXPIRATION_CANDLES=6
PREFLIGHT_BUFFER_PCT=0.05

# Live entry filters (defaults are the live-correct values, restated for clarity).
# Killzones ON = London/NY only; ALLOWED_DAYS_OF_WEEK 1-5 = no weekend entries.
ENFORCE_KILLZONES=true
ALLOWED_DAYS_OF_WEEK=1,2,3,4,5,6,7

ENABLE_TRADE_NOTIFICATIONS=false
ENABLE_FUNDING_MONITOR=false
FUNDING_MONITOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,AVAXUSDT,SUIUSDT,NEARUSDT,APTUSDT
FUNDING_ALERT_THRESHOLD_PCT=0.0
FUNDING_RESTORE_THRESHOLD_PCT=0.015

LOG_LEVEL=info
DATA_DIR=data
ENABLE_HEALTHCHECK_SERVER=false

# Backtest-only knobs (inert while the process trades live).
BACKTEST_DAYS=60
USE_LOCAL_CACHE_ONLY=true
BACKTEST_CSV_PATH=

# --- Frozen-profile notes -------------------------------------------------
# MIN_NET_RR and MIN_VOLATILITY_FEE_RATIO are Scenario 12 ONLY. They are inert
# for every Classic scenario, which is why they do not appear in .env.subaru.
#
# SMC_SL_ATR_OFFSET_APTUSDT=0.60 supersedes the previous 0.90 calibration.
# A smaller ATR multiple tightens the stop; with SNIPER_LIMIT_EXPIRATION_CANDLES
# at 25 it is part of the same grid-search cell and must not be changed alone.
#
# Verify the resolved Sniper lifetime in the run log: it must read 15 minutes
# for NEARUSDT and 25 minutes for APTUSDT. An ambient
# SNIPER_LIMIT_EXPIRATION_CANDLES=6 silently reproduces the Classic 6-candle
# lifetime in 1m units (AGENTS.md §7.13.3 config-drift warning).
