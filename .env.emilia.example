# ============================================================
# .env.emilia — V5 SNIPER PRODUCTION PROFILE (NEARUSDT, Scenario 12)
# 1m execution / 15m radar / 4H macro context
# ============================================================
# This file is a PROFILE, not a standalone deployment: it deliberately contains
# NO API keys, Telegram tokens or database URLs. Inject the secrets listed in
# "REQUIRED SECRETS" through the platform (Docker env_file chain, Render
# dashboard, systemd EnvironmentFile) before the process can boot.
#
# The local .env mirrors this file line-for-line for every non-secret setting;
# only the credentials block differs. Keep the two in sync when either changes.
#
# Complement: .env.subaru (V4 Classic — BTCUSDT, S14 + S15, 4H ADX gate).
# The two profiles MUST NEVER share a process, database, Telegram bot or Bybit
# sub-account: the per-symbol IN_TRADE slot is mutually exclusive (AGENTS.md §1.2,
# §1.3, Invariant §16.3.8).
#
# Validated baseline: 180-day endurance audit (AGENTS.md §7.23) — +22.40%,
# 12 trades, 58.33% WR, PF 3.24, Max DD 4.74% at the audited NEAR calibration.
# Cadence is episodic (0 trades in May/June, 7 of 12 in October, longest dry
# spell 49.6 days), so the 60-day +28.49% control is a cluster, not a run-rate.
# ============================================================

# --- V5 SNIPER PROFILE (EMILIA) ---
SYMBOLS=NEARUSDT
ENABLE_SNIPER_MODE=true
ACTIVE_SCENARIOS=12

# Sniper Mode still reads the 15m radar + 4H macro feeds.
LTF_TIMEFRAME=15
HTF_TIMEFRAME=240
HISTORY_CANDLES=200
MACRO_CANDLES=1000
COOLDOWN_CANDLES=16
# Classic limit lifetime (inert here — Sniper resolves its own 1m knob below).
LIMIT_EXPIRATION_CANDLES=6

# --- Dynamic Take-Profit (structural targets via tpResolver.ts) ---
ENABLE_DYNAMIC_TP=true
DYNAMIC_TP_MIN_RR=1.5
DYNAMIC_TP_MAX_RR=6.0
FIXED_TP_RR=3.0
DYNAMIC_TP_REQUIRE_TARGET=false

# --- S12 sweep sources (opt-in; macro PDH/PDL/PWH/PWL are always armed) ---
S12_SESSION_SWEEPS=true
S12_EQH_EQL_SWEEPS=true

# --- S12 P0 shields & execution ---
# Global shields stay at 1.5 for every pair without an audited exception.
MIN_NET_RR=1.5
MIN_VOLATILITY_FEE_RATIO=1.5
MIN_TP_DISTANCE_PCT=0.0035
SMC_SWEEP_MIN_WICK_RATIO=0.25
SMC_SL_ATR_OFFSET=0.5
SMC_DISPLACEMENT_MULTIPLIER=1.5
# Limit lifetime in 1m EXECUTION candles: 15 x 1m = 15 minutes.
SNIPER_LIMIT_EXPIRATION_CANDLES=15
SNIPER_DISPLACEMENT_MULTIPLIER=1.5
SMART_ENTRY_THRESHOLD_PCT=0.15
PREFLIGHT_BUFFER_PCT=0.05

# --- Per-symbol calibration ---
# NEARUSDT: audited 180-day exception (AGENTS.md §7.23). Both knobs must move
# together: volatility alone at 1.0 measures +14.87%; the pair measures +22.40%.
MIN_VOLATILITY_FEE_RATIO_NEARUSDT=1.0
MIN_NET_RR_NEARUSDT=1.0
# Future pairs (inactive until added to SYMBOLS): APTUSDT was the previous
# secondary pair. Its calibration remains documented for a future revival:
#   SMC_SL_ATR_OFFSET_APTUSDT=0.60
#   SNIPER_LIMIT_EXPIRATION_CANDLES_APTUSDT=25

# ============================================================
# REQUIRED SECRETS — enumerates only, no values (inject at deploy)
# ============================================================
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# DATABASE_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BACKUP_PASSWORD=
#
# loadConfig() hard-fails without SYMBOLS (above), RISK_PERCENT (below),
# BYBIT_API_KEY and BYBIT_API_SECRET. The live bootstrap additionally needs
# DATABASE_URL (read by PostgresDatabase) and TELEGRAM_BOT_TOKEN /
# TELEGRAM_CHAT_ID for alerts. See .env.example for the full reference.

# ============================================================
# ACCOUNT & RISK
# ============================================================
# RISK_PERCENT is REQUIRED (no default); loadConfig() throws when absent.
RISK_PERCENT=2
REDUCED_RISK_PERCENT=1
LEVERAGE=10

# Capacity cap for position sizing and the Drawdown Guard (USDT).
# Must be a positive number — a literal 0 fails validation (AGENTS.md Inv. 55).
MAX_WORKING_CAPITAL=3000

# DEMO_TRADING=true forces TESTNET=false (Bybit Demo, virtual balance).
DEMO_TRADING=true
TESTNET=false
AUTO_TRADING=true
TRADE_APPROVAL_TIMEOUT_MINUTES=10
ENABLE_LIVE_TEST_ORDERS=false

# ============================================================
# BACKTEST WINDOW
# ============================================================
BACKTEST_DAYS=60

# true = zero network calls: load strictly from the local 1m/15m/4H caches.
USE_LOCAL_CACHE_ONLY=true

# BACKTEST_CSV_PATH=

# ============================================================
# ENTRY FILTERS — live parity
# ============================================================
# Both filters are ENTRY-only; an open trade is always managed.
ENFORCE_KILLZONES=true
ALLOWED_DAYS_OF_WEEK=1,2,3,4,5,6,7

# === REGIME FILTER (4H ADX) ===
# Router-level gate. It only classifies S5/S12 (counter-trend) and S14
# (trend-breakout); a S12-only deployment therefore never consults it. The
# toggle is kept for parity with the global default and the local .env.
ENABLE_REGIME_FILTER=false
REGIME_ADX_THRESHOLD=25

# ============================================================
# NOTIFICATIONS, SERVICES, LOGGING
# ============================================================
ENABLE_TRADE_NOTIFICATIONS=true
ENABLE_FUNDING_MONITOR=false
FUNDING_MONITOR_SYMBOLS=NEARUSDT
FUNDING_ALERT_THRESHOLD_PCT=0.0
FUNDING_RESTORE_THRESHOLD_PCT=0.015

LOG_LEVEL=info
DATA_DIR=data
# Required on Render: exposes GET /health for the platform liveness probe.
ENABLE_HEALTHCHECK_SERVER=true

# --- Frozen-profile notes -------------------------------------------------
# MIN_NET_RR and MIN_VOLATILITY_FEE_RATIO are Scenario 12 ONLY. They are inert
# for every Classic scenario, which is why they do not appear in .env.subaru.
#
# Verify the resolved Sniper lifetime in the run log: it must read 15 minutes
# for NEARUSDT. An ambient SNIPER_LIMIT_EXPIRATION_CANDLES=6 silently reproduces
# the Classic 6-candle lifetime in 1m units (AGENTS.md §7.13.3 config-drift
# warning).
