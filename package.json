{
  "name": "crypto-bot-smc",
  "version": "0.1.0",
  "private": true,
  "description": "Bybit V5 multi-strategy quantitative trading engine & backtester",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --config jest.config.ci.js --runInBand --coverage",
    "backtest": "tsc && node dist/backtest/run.js",
    "matrix:test": "ts-node scripts/matrix_tester.ts",
    "dn:backtest": "tsc && node dist/dn_arbitrage/backtest/run.js",
    "funding:analyze": "ts-node scripts/funding_history_analyzer.ts",
    "decrypt": "ts-node scripts/decrypt_backup.ts"
  },
  "dependencies": {
    "bybit-api": "^4.7.4",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "telegraf": "^4.16.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.4.2",
    "jest-html-reporters": "^3.1.7",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
