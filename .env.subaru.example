# ============================================================
# .env.subaru — V4 CLASSIC PRODUCTION PROFILE (BTCUSDT)
# Scenarios 14 + 15 on 15m execution (4H HTF context)
# 4H ADX regime gate ENABLED
# ============================================================
# This file is a PROFILE, not a standalone deployment: it deliberately contains
# NO API keys, Telegram tokens or database URLs. Inject the secrets listed in
# "REQUIRED SECRETS" through the platform (Docker env_file chain, Render
# dashboard, systemd EnvironmentFile) before the process can boot.
#
# Complement: .env.emilia (V5 Sniper — NEARUSDT, Scenario 12, 1m execution).
# The two profiles MUST NEVER share a process, database, Telegram bot or Bybit
# sub-account: the per-symbol IN_TRADE slot is mutually exclusive (AGENTS.md §1.2,
# §1.3, Invariant §16.3.8).
#
# Validated combination: S14 (Donchian trend breakout) + S15 (volatility
# squeeze) on BTCUSDT, 15m entries / 4H macro, with the router-level 4H ADX
# gate enabled. 365-day filtered matrix (2025-11-08 → 2026-11-08, $1,000):
#   +28.40% | 123 trades | 50W/73L | 40.65% WR | PF 1.20 | Max DD 28.25%
#   Fees $420.02 | 7/13 profitable months
# Controlled A/B against the same profile with the gate OFF:
#   +15.69% | 158 trades | PF 1.09 | Max DD 28.71%
# Honest caveat: the filter improved 5 of 7 matrix symbols and the portfolio
# from -27.98% to -22.29%, but 0/7 symbols cleared the alpha gate
# (Net > 10%, DD < 10%, PF > 1.5). BTC is the only profitable pair and its
# 28.25% drawdown still exceeds the 10% gate. This is a validated production
# profile for BTC, not a portfolio-wide edge (AGENTS.md §7.24).
# ============================================================

# --- V4 CLASSIC PROFILE (SUBARU) ---
SYMBOLS=BTCUSDT
ENABLE_SNIPER_MODE=false
ACTIVE_SCENARIOS=14,15

# --- Timeframes & history ---
LTF_TIMEFRAME=15
HTF_TIMEFRAME=240
HISTORY_CANDLES=200
MACRO_CANDLES=1000
# Cooldown after a stop-loss, in LTF candles (16 x 15m = 4h). Wins set no cooldown.
COOLDOWN_CANDLES=16
# Limit lifetime in LTF candles (6 x 15m = 90 min) — Classic mode only. Sniper
# Mode has its own 1m knob in .env.emilia.
LIMIT_EXPIRATION_CANDLES=6

# --- Dynamic Take-Profit (structural targets instead of blind k * R) ---
# Evaluated by S14 and S15. 1.5 is the value used by the validated 365-day run.
ENABLE_DYNAMIC_TP=true
DYNAMIC_TP_MIN_RR=1.5
DYNAMIC_TP_MAX_RR=6.0
FIXED_TP_RR=3.0
DYNAMIC_TP_REQUIRE_TARGET=false

# --- General SMC ---
SMC_SL_ATR_OFFSET=0.5
SMC_DISPLACEMENT_MULTIPLIER=1.5
# S5-only knob: S5 is NOT active in this profile, so the volume gate is dead
# configuration here. Kept commented for a future S5 revival.
# SMC_SWEEP_VOLUME_MULTIPLIER=1.3
SMART_ENTRY_THRESHOLD_PCT=0.15
PREFLIGHT_BUFFER_PCT=0.05

# ============================================================
# REQUIRED SECRETS — enumerates only, no values (inject at deploy)
# ============================================================
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# DATABASE_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BACKUP_PASSWORD=
#
# loadConfig() hard-fails without SYMBOLS, RISK_PERCENT, BYBIT_API_KEY and
# BYBIT_API_SECRET. The live bootstrap additionally needs DATABASE_URL (read by
# PostgresDatabase) and TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID for alerts.
# See .env.example for the full reference.

# ============================================================
# ACCOUNT & RISK
# ============================================================
# RISK_PERCENT is REQUIRED (no default); loadConfig() throws when absent.
RISK_PERCENT=2
REDUCED_RISK_PERCENT=1
LEVERAGE=10

# Capacity cap for position sizing and the Drawdown Guard (USDT).
# Must be a positive number — a literal 0 fails validation (AGENTS.md Inv. 55).
MAX_WORKING_CAPITAL=3000

DEMO_TRADING=true
TESTNET=false
AUTO_TRADING=true
TRADE_APPROVAL_TIMEOUT_MINUTES=10
ENABLE_LIVE_TEST_ORDERS=false

# ============================================================
# ENTRY FILTERS — live parity
# ============================================================
# Both filters are ENTRY-only; an open trade is always managed.
ENFORCE_KILLZONES=true
ALLOWED_DAYS_OF_WEEK=1,2,3,4,5,6,7

# === REGIME FILTER (4H ADX) ===
# Router-level gate evaluated once per pass on the CLOSED 4H window:
#   ADX >= 25 (TREND) → block counter-trend sweeps  (S5, S12)
#   ADX <  25 (RANGE) → block trend breakouts       (S14)
# S1 and S15 carry their own macro conditions and are never gated.
# Entry filter ONLY — open trades keep being managed regardless.
# This is the exact setting measured by the 365-day BTC audit above.
ENABLE_REGIME_FILTER=true
REGIME_ADX_THRESHOLD=25

# ============================================================
# NOTIFICATIONS, SERVICES, LOGGING
# ============================================================
ENABLE_TRADE_NOTIFICATIONS=true
ENABLE_FUNDING_MONITOR=true
FUNDING_MONITOR_SYMBOLS=BTCUSDT
FUNDING_ALERT_THRESHOLD_PCT=0.0
FUNDING_RESTORE_THRESHOLD_PCT=0.015

LOG_LEVEL=info
DATA_DIR=data
ENABLE_HEALTHCHECK_SERVER=true

# ============================================================
# BACKTEST WINDOW
# ============================================================
# One full annual cycle: 365 days of 15m (~35,040 candles) + 4H (~2,190).
BACKTEST_DAYS=365
USE_LOCAL_CACHE_ONLY=true
BACKTEST_CSV_PATH=

# --- Profile invariants ---------------------------------------------------
# 1. No S12-only key belongs in this file: MIN_NET_RR, MIN_VOLATILITY_FEE_RATIO,
#    MIN_TP_DISTANCE_PCT, S12_SESSION_SWEEPS, S12_EQH_EQL_SWEEPS and
#    SNIPER_LIMIT_EXPIRATION_CANDLES are read exclusively by Scenario 12. A knob
#    that is never evaluated is worse than an absent one — it reads as protection
#    while doing nothing (AGENTS.md §1.3 profile invariant 2, §7.13.5).
# 2. MAX_WORKING_CAPITAL=3000 caps sizing, the margin buffer and the Drawdown
#    Guard at a $3,000 working balance regardless of account equity.
# 3. The ADX gate is entry-only. Removing it changes the entry funnel but never
#    the management of an open trade (AGENTS.md Inv. 62).
