# ============================================================
# .env.subaru — V4 CLASSIC TANK PROFILE
# Scenarios 5 + 14 + 15 on 15m execution (4H HTF context)
# ============================================================
# This file is a PROFILE, not a standalone deployment: it deliberately contains
# NO API keys, Telegram tokens or database URLs. Inject the secrets listed in
# "REQUIRED SECRETS" through the platform (Docker env_file chain, Render
# dashboard, systemd EnvironmentFile) before the process can boot.
#
# Complement: .env.emilia (V5 Sniper — Scenario 12, 1m execution).
# The two profiles MUST NEVER share a process, database, Telegram bot or Bybit
# sub-account: the per-symbol IN_TRADE slot is mutually exclusive (AGENTS.md §1.2,
# §1.3, Invariant §16.3.8).
#
# Scenario mix is per symbol, not global. A macro-liquidity sweep pair (S5), a
# trend pair (S14) and a squeeze pair (S15) rarely fire on the same chart, so the
# global list is only a fallback and each symbol narrows itself below.
# ============================================================

# --- V4 CLASSIC TANK PROFILE (SUBARU) ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT
ENABLE_SNIPER_MODE=false

# Global fallback. Every symbol below sets its own SCENARIOS_<SYMBOL>, so this
# line only governs a pair added to SYMBOLS without an override.
# Live registry is 1, 5, 12, 14, 15. S12 must never appear here: with
# ENABLE_SNIPER_MODE=false, loadConfig() aborts the boot.
ACTIVE_SCENARIOS=14

# Per-symbol scenario selection. A SCENARIOS_<SYMBOL> line REPLACES the global
# list for that symbol — it does not intersect with it — so listing 5 and 15 for
# BTC while the global is 14 keeps both. The list is validated against the live
# registry, de-duplicated and sorted at parse time; the written order is cosmetic
# (S5 is constructed before S14/S15 regardless).
SCENARIOS_BTCUSDT=14,15,5
SCENARIOS_ETHUSDT=14
SCENARIOS_SOLUSDT=14,5
SCENARIOS_DOGEUSDT=15

# --- Timeframes & history ---
LTF_TIMEFRAME=15
HTF_TIMEFRAME=240
HISTORY_CANDLES=200
MACRO_CANDLES=1000
# Cooldown after a stop-loss, in LTF candles (16 x 15m = 4h). Wins set no cooldown.
COOLDOWN_CANDLES=16
# Limit lifetime in LTF candles (6 x 15m = 90 min) — Classic mode only. Sniper
# Mode has its own 1m knob in .env.emilia.
LIMIT_EXPIRATION_CANDLES=6

# --- Dynamic Take-Profit (structural targets instead of blind k * R) ---
# Evaluated by S5, S14 and S15. S5 additionally reads DYNAMIC_TP_MIN_RR as its
# fee-inclusive net-R:R floor: netRr = (target - fee) / (stop + fee) >= 2.0.
ENABLE_DYNAMIC_TP=true
DYNAMIC_TP_MIN_RR=2.0
DYNAMIC_TP_MAX_RR=6.0

# --- General SMC ---
SMC_SL_ATR_OFFSET=0.5
SMC_DISPLACEMENT_MULTIPLIER=1.5
# Scenario 5 only: sweep-candle volume as a multiple of the 20-candle SMA
# baseline that precedes it (1.3 = +30% institutional expansion).
SMC_SWEEP_VOLUME_MULTIPLIER=1.3
SMART_ENTRY_THRESHOLD_PCT=0.15
PREFLIGHT_BUFFER_PCT=0.05

# ============================================================
# REQUIRED SECRETS — enumerates only, no values (inject at deploy)
# ============================================================
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# DATABASE_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BACKUP_PASSWORD=
#
# loadConfig() hard-fails without SYMBOLS, RISK_PERCENT, BYBIT_API_KEY and
# BYBIT_API_SECRET. The live bootstrap additionally needs DATABASE_URL (read by
# PostgresDatabase) and TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID for alerts.
# See .env.example for the full reference.

# ============================================================
# OPERATIONAL SCAFFOLDING — non-secret, carried over from the previous
# Subaru deployment. Not part of the Tank strategy spec.
# ============================================================
# RISK_PERCENT is REQUIRED (no default); loadConfig() throws when absent.
RISK_PERCENT=2
REDUCED_RISK_PERCENT=1
LEVERAGE=10

# Capacity cap for position sizing and the Drawdown Guard (USDT).
# Must be a positive number — a literal 0 fails validation (AGENTS.md Inv. 55).
MAX_WORKING_CAPITAL=3000

DEMO_TRADING=true
TESTNET=false
AUTO_TRADING=true
TRADE_APPROVAL_TIMEOUT_MINUTES=5
ENABLE_LIVE_TEST_ORDERS=false

# Classic entry filters (entry ONLY — active trade management is never gated).
ENFORCE_KILLZONES=false
ALLOWED_DAYS_OF_WEEK=1,2,3,4,5,6,7

ENABLE_TRADE_NOTIFICATIONS=false
ENABLE_FUNDING_MONITOR=true
FUNDING_MONITOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT
FUNDING_ALERT_THRESHOLD_PCT=0.0
FUNDING_RESTORE_THRESHOLD_PCT=0.015

LOG_LEVEL=info
DATA_DIR=data
ENABLE_HEALTHCHECK_SERVER=true

# Backtest-only knobs (inert while the process trades live).
BACKTEST_DAYS=180
USE_LOCAL_CACHE_ONLY=true
BACKTEST_CSV_PATH=

# --- Profile invariants ---------------------------------------------------
# 1. No S12-only key belongs in this file: MIN_NET_RR, MIN_VOLATILITY_FEE_RATIO,
#    MIN_TP_DISTANCE_PCT, S12_SESSION_SWEEPS, S12_EQH_EQL_SWEEPS and
#    SNIPER_LIMIT_EXPIRATION_CANDLES are read exclusively by Scenario 12. A knob
#    that is never evaluated is worse than an absent one — it reads as protection
#    while doing nothing (AGENTS.md §1.3 profile invariant 2, §7.13.5).
# 2. DYNAMIC_TP_MIN_RR=2.0 is global by design: three Classic engines share it,
#    and a per-symbol DYNAMIC_TP_MIN_RR_<SYMBOL> would be the only sanctioned way
#    to relax one pair. Raise/lower it only against a measured backtest.
# 3. MAX_WORKING_CAPITAL=3000 caps sizing, the margin buffer and the Drawdown
#    Guard at a $3,000 working balance regardless of account equity.
