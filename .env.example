# ============================================================
# .env.example — full configuration reference
# ============================================================
# Copy to .env (local development) or merge into a deployment profile.
#
# LIVE SCENARIO REGISTRY — only these five IDs are accepted:
#   1  HTF Continuation        15m Classic
#   5  HTF Liquidity Sweep     15m Classic
#   12 Sniper Touch            1m Sniper (requires ENABLE_SNIPER_MODE=true)
#   14 Trend Following Alpha   15m Classic
#   15 Volatility Squeeze      15m Classic
#
# Anything else fails validation at boot. Archived and NOT tradeable:
#   2, 3, 4, 6, 7, 8, 9, 10, 11  (legacy SMC discovery sweep)
#   13                           (Top-Down Order Flow)
# A per-symbol SCENARIOS_<SYMBOL> list is validated just as strictly: an archived
# id is a hard error, never a silent drop.
#
# Two frozen presets ship as separate templates — they are the AUTHORITATIVE
# deployment files, and this document is their reference, not a third preset:
#   .env.subaru.example — V4 CLASSIC: S14 + S15, 15m, Sniper OFF
#                         (BTCUSDT, 4H ADX regime gate ENABLED)
#   .env.emilia.example — V5 SNIPER:  S12, 1m, Sniper ON
#                         (NEARUSDT)
# Neither carries secrets; they are injected at deploy time.
# NEVER run both profiles in one process/database/exchange sub-account
# (the per-symbol IN_TRADE slot is mutually exclusive — AGENTS.md §1.3).
#
# Values below are CODE DEFAULTS unless marked otherwise, so a key that is
# omitted here still behaves predictably. Where a preset deliberately departs
# from the default, the comment says so — see "PRESET DIVERGENCE" at the end.
# ============================================================

# --- Credentials ---
# loadConfig() throws when BYBIT_API_KEY or BYBIT_API_SECRET is absent.
# The live bootstrap additionally needs DATABASE_URL (read by PostgresDatabase)
# and TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID for alerts; BACKUP_PASSWORD enables
# the /backup command.
BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=
# Backup encryption password (AES-256-CBC)
BACKUP_PASSWORD=

# --- Environment ---
TESTNET=true
# true = Bybit Demo (virtual balance, real market data). Forces TESTNET=false.
DEMO_TRADING=true
ENABLE_LIVE_TEST_ORDERS=false

# ============================================================
# CLASSIC BLOCK — scenario/timeframe shape of .env.subaru.example
# S14 + S15 on 15m candles. Sniper Mode OFF.
# Operational knobs below stay at their code defaults; the divergence table at
# the end lists every value the Subaru preset changes.
# ============================================================
SYMBOLS=BTCUSDT
ENABLE_SNIPER_MODE=false
# Single symbol, single list. No per-symbol override is needed in the Subaru
# preset. Classic-only registry. S12 cannot be listed here: loadConfig() throws
# "FATAL: Scenario 12 requires ENABLE_SNIPER_MODE=true."
ACTIVE_SCENARIOS=14,15

# --- Risk & capacity ---
# RISK_PERCENT is REQUIRED (no default); must be > 0.
RISK_PERCENT=2
# Risk after 3 consecutive losses; must be <= RISK_PERCENT.
REDUCED_RISK_PERCENT=1
LEVERAGE=10
# Strategy capacity limit in USDT. OMIT the line entirely for unlimited.
# A literal 0 fails validation — `MAX_WORKING_CAPITAL` must be a positive number.
# When balance > cap, position sizing, margin buffer and the Drawdown Guard all
# use the capped working balance (AGENTS.md Inv. 55).
# Both shipped presets pin this to 3000; 20000 is the reference example value.
MAX_WORKING_CAPITAL=3000

# --- Execution mode ---
AUTO_TRADING=false
TRADE_APPROVAL_TIMEOUT_MINUTES=5
LOG_LEVEL=info
DATA_DIR=data

# --- Timeframes & history ---
LTF_TIMEFRAME=15
HTF_TIMEFRAME=240
HISTORY_CANDLES=200
MACRO_CANDLES=1000
# Cooldown after SL hit, in LTF candles (16 x 15m = 4h).
COOLDOWN_CANDLES=16

# --- Hybrid Smart Entry (Market vs Limit) ---
SMART_ENTRY_THRESHOLD_PCT=0.15
# Limit lifetime in LTF candles (6 x 15m = 90 min).
LIMIT_EXPIRATION_CANDLES=6
# Pre-flight spread buffer (%, default 0.05 = 0.05%)
PREFLIGHT_BUFFER_PCT=0.05

# --- SMC core mathematics ---
SMC_SL_ATR_OFFSET=0.5
SMC_DISPLACEMENT_MULTIPLIER=1.5
# Scenario 5 only: minimum sweep-candle volume as a multiple of the 20-candle
# SMA baseline that precedes it (1.3 = +30% institutional expansion).
SMC_SWEEP_VOLUME_MULTIPLIER=1.3

# --- Dynamic Take-Profit (structural targets instead of blind k * R) ---
# Used by Scenarios 1, 5, 14, 15 (Classic) and 12 (Sniper).
ENABLE_DYNAMIC_TP=true
FIXED_TP_RR=3.0
# Upper bound for a structural target; also the ceiling for every per-symbol
# DYNAMIC_TP_MIN_RR_<SYMBOL> floor (validated at parse time).
DYNAMIC_TP_MAX_RR=6.0
# Structural target floor (R multiples). Scenario 5 ALSO reads this as its
# fee-inclusive net-R:R gate, so raising it tightens S5 entries too.
# Code default 1.5; both shipped presets run 1.5 (AGENTS.md §8.8.1).
DYNAMIC_TP_MIN_RR=1.5
# true = reject the setup when no structural target clears DYNAMIC_TP_MIN_RR;
# false = fall back to FIXED_TP_RR x R.
DYNAMIC_TP_REQUIRE_TARGET=false

# --- Per-symbol calibration overrides (Classic-relevant) ---
# Every key below accepts a `<PARAM>_<SYMBOL>` twin that overrides the global
# value for that symbol ONLY. Resolution happens once per symbol through
# resolveSymbolConfig() and reaches every scenario, tpResolver and the
# reconciliation sweep — live and backtest alike.
#
# The suffix is matched against the SYMBOLS list, so an override for a pair that
# is not configured is SILENTLY IGNORED (a stray key from an earlier run cannot
# resurrect calibration for an untraded symbol).
#
# Classic overridable parameters:
#   DYNAMIC_TP_MIN_RR_<SYMBOL>   (must be <= the global DYNAMIC_TP_MAX_RR)
#   SMC_SL_ATR_OFFSET_<SYMBOL>
#
# S12-ONLY overrides (MIN_TP_DISTANCE_PCT_<SYMBOL>, MIN_NET_RR_<SYMBOL>,
# MIN_VOLATILITY_FEE_RATIO_<SYMBOL>, SMC_SWEEP_MIN_WICK_RATIO_<SYMBOL>,
# SNIPER_LIMIT_EXPIRATION_CANDLES_<SYMBOL>) are documented in PROFILE B. Listing
# them here would be dead configuration: no Classic scenario reads them, so the
# key would read as protection while silently doing nothing (AGENTS.md §7.13.5).
#
# SCENARIOS_<SYMBOL> is a separate family (scenario selection, not calibration).
# Unset = the symbol uses ACTIVE_SCENARIOS. Setting it REPLACES the global list
# for that symbol — it does not add to it. Ids are validated against the live
# registry, de-duplicated and sorted at parse time.
# The Subaru preset trades one symbol and needs no override. A multi-symbol
# Classic deployment can narrow each pair, e.g.:
#   SCENARIOS_BTCUSDT=14,15
#   SCENARIOS_ETHUSDT=14
#   SCENARIOS_SOLUSDT=14,15

# --- Entry filters (entry ONLY — active trade management is never gated) ---
# ISO weekdays in UTC (1=Monday ... 7=Sunday) allowed for NEW entries.
ALLOWED_DAYS_OF_WEEK=1,2,3,4,5
# true = entries require London/NY killzone; false = bypass globally (backtesting).
ENFORCE_KILLZONES=true

# --- Regime filter (4H ADX gate, router-level, entry ONLY) ---
# false = baseline: every scenario evaluates on every pass (default).
# true  = classify the closed 4H tape once per pass with ADX(14):
#           ADX >= threshold (TREND) → block counter-trend sweeps (S5, S12)
#           ADX <  threshold (RANGE) → block trend breakouts      (S14)
#         Scenarios 1 and 15 carry their own macro conditions and are never gated.
ENABLE_REGIME_FILTER=false
# ADX is bounded 0..100; values above 100 abort the boot (silent off-switch).
REGIME_ADX_THRESHOLD=25

# Routine trade notifications (false = mute Setup Found / Order Opened /
# Position Closed / Cancelled Limit). Critical logger.error alerts are NEVER
# muted — they flow through the global Telegram hook.
ENABLE_TRADE_NOTIFICATIONS=true

# --- Funding Monitor (delta-neutral arbitrage) ---
ENABLE_FUNDING_MONITOR=false
FUNDING_MONITOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
FUNDING_ALERT_THRESHOLD_PCT=0.0
FUNDING_RESTORE_THRESHOLD_PCT=0.015

# --- Backtest ---
# Shared history window for the 1m / LTF / HTF loaders.
BACKTEST_DAYS=60
# true = offline: load strictly from local .json cache, throw on cache miss.
USE_LOCAL_CACHE_ONLY=true
# Optional local CSV source (enables offline CSV data loading).
BACKTEST_CSV_PATH=

# --- Health Check ---
# Required true on Render.com / cloud platforms exposing a load balancer.
# Code default false; both shipped presets set true.
ENABLE_HEALTHCHECK_SERVER=false

# ============================================================
# PROFILE B — V5 SNIPER (COMMENTED — do not enable alongside the Classic block)
# ------------------------------------------------------------
# S12 on 1m entries. Authoritative preset: .env.emilia.example. To deploy:
# comment out the Classic block's SYMBOLS / ENABLE_SNIPER_MODE /
# ACTIVE_SCENARIOS / SCENARIOS_<SYMBOL> lines, uncomment this block, and run it
# as a SEPARATE process with its own database, Telegram bot and Bybit
# sub-account.
#
# Verified calibration: 180 days, NEARUSDT, $1,000 (AGENTS.md §7.23).
# Global 1.5/1.5 shields → +3.46%; volatility alone at 1.0 → +14.87%;
# both at 1.0 → +22.40% (PF 3.24, Max DD 4.74%). Trade cadence is episodic:
# 0 trades in May and June, 7 of 12 in October, longest dry spell 49.6 days.
# Do not annualise that figure into a monthly target.
#
# Every key below is annotated with its CODE DEFAULT; the uncommented value is
# the verified preset value where they differ.
# ============================================================
# SYMBOLS=NEARUSDT
# ENABLE_SNIPER_MODE=true
# ACTIVE_SCENARIOS=12
#
# # Sniper Mode still reads the 15m radar + 4H macro feeds.
# LTF_TIMEFRAME=15
# HTF_TIMEFRAME=240
# HISTORY_CANDLES=200
# MACRO_CANDLES=1000
# SNIPER_DISPLACEMENT_MULTIPLIER=1.5
#
# # S12 sweep sources (opt-in; macro PDH/PDL/PWH/PWL are always armed).
# # Code default: false for both. The preset arms both.
# # Session: the newest ASIAN high/low becomes a sweepable level.
# S12_SESSION_SWEEPS=true
# # EQH/EQL: 15m equal highs/lows become sweepable levels.
# S12_EQH_EQL_SWEEPS=true
#
# # Limit lifetime in 1m EXECUTION candles (15 = 15 min). Code default: 15.
# # Independent of the Classic knob: 6 candles are 90 min on 15m but only 6 min
# # on 1m. Resolve through resolveLimitExpirationCandles() and verify the
# # resolved value in the run log.
# SNIPER_LIMIT_EXPIRATION_CANDLES=15
#
# # Fee-aware target floor: reject targets closer than this fraction of the
# # EXECUTION entry (market price for a Market fill, OB midpoint for a resting
# # Limit — AGENTS.md Inv. 61). Must be > 0 and < 0.1. Code default: 0.0035.
# # Bybit round-trip taker fees are ~0.110%.
# MIN_TP_DISTANCE_PCT=0.0035
#
# # P0 arithmetic shields (S12 only). Code default: 1.0 for both.
# # MIN_NET_RR: fee-inclusive reward:risk floor.
# #   netRr = (targetDistance - roundTripFee) / (stopDistance + roundTripFee)
# #   Rejected with the `insufficientNetR` bucket.
# MIN_NET_RR=1.5
# # MIN_VOLATILITY_FEE_RATIO: ATR-to-fee admission multiple.
# #   Requires 1m ATR% >= ratio x round-trip fee (~0.110%). 1.5 => ATR >= ~0.165%.
# #   Rejected with the `insufficientVolatility` bucket.
# MIN_VOLATILITY_FEE_RATIO=1.5
# # Min rejection wick as a share of the candle range (0 < x < 1). Code default 0.25.
# SMC_SWEEP_MIN_WICK_RATIO=0.25
#
# # Per-symbol calibration (S12 only).
# # NEARUSDT: audited 180-day exception. Both knobs must move together —
# # volatility alone at 1.0 yields +14.87%, the pair yields +22.40%.
# MIN_VOLATILITY_FEE_RATIO_NEARUSDT=1.0
# MIN_NET_RR_NEARUSDT=1.0
# # APTUSDT (inactive — not in SYMBOLS): previous secondary pair. Its
# # calibration remains documented for a future revival (same grid-search cell;
# # never change one without the other).
# SMC_SL_ATR_OFFSET=0.5
# SMC_SL_ATR_OFFSET_APTUSDT=0.60
# SNIPER_LIMIT_EXPIRATION_CANDLES_APTUSDT=25
# # MIN_TP_DISTANCE_PCT_APTUSDT=0.0046
# # MIN_NET_RR_APTUSDT=1.5
# # MIN_VOLATILITY_FEE_RATIO_APTUSDT=1.5
# # SMC_SWEEP_MIN_WICK_RATIO_APTUSDT=0.25
# # DYNAMIC_TP_MIN_RR_APTUSDT=1.5
#
# # Killzones and weekday filters are ENTRY-only gates — irrelevant to active
# # trade management. The production Emilia preset enforces London/NY.
# ENFORCE_KILLZONES=true
# ALLOWED_DAYS_OF_WEEK=1,2,3,4,5,6,7

# ============================================================
# PRESET DIVERGENCE — where the shipped presets differ from code defaults
# ------------------------------------------------------------
# Knob                          code default   .env.subaru   .env.emilia
# SYMBOLS                       (required)     BTCUSDT       NEARUSDT
# ENABLE_SNIPER_MODE            false          false         true
# ACTIVE_SCENARIOS              (all five)     14,15         12
# SCENARIOS_<SYMBOL>            unset          unset         unset
# DYNAMIC_TP_MIN_RR             1.5            1.5           1.5
# SMC_SWEEP_VOLUME_MULTIPLIER   1.3            absent        absent (S5 only)
# MIN_NET_RR                    1.0            absent        1.5 (NEAR: 1.0)
# MIN_VOLATILITY_FEE_RATIO      1.0            absent        1.5 (NEAR: 1.0)
# MIN_TP_DISTANCE_PCT           0.0035         absent        0.0035
# S12_SESSION_SWEEPS            false          absent        true
# S12_EQH_EQL_SWEEPS            false          absent        true
# SNIPER_LIMIT_EXPIRATION_...   15             absent        15
# ENABLE_REGIME_FILTER          false          true          false
# REGIME_ADX_THRESHOLD          25             25            25
# ENFORCE_KILLZONES             true           true          true
# ALLOWED_DAYS_OF_WEEK          1,2,3,4,5      1..7          1..7
# BACKTEST_DAYS                 60             365           60
# ENABLE_FUNDING_MONITOR        false          true          false
# ENABLE_HEALTHCHECK_SERVER     false          true          true
# MAX_WORKING_CAPITAL           0 (unlimited)  3000          3000
# AUTO_TRADING                  false          true          true
#
# "absent" is deliberate, not an omission: a knob that no scenario in that
# profile evaluates is dead configuration, and dead configuration reads as
# protection while providing none (AGENTS.md §1.3 profile invariant 2).
#
# Local `.env` mirrors `.env.emilia` for every non-secret strategy value; the
# only difference is the credentials block (the shipped templates carry
# placeholder comments instead).

